{
  "name": "@infini/coach-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:local": "VITE_INFINI_ENV=local VITE_BASE_PATH=/ VITE_API_BASE_PATH= vite build",
    "build:production": "VITE_INFINI_ENV=production VITE_BASE_PATH=/infini/coach/ VITE_API_BASE_PATH=/infini vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:allure": "INFINI_ALLURE=1 vitest run --coverage",
    "coverage": "pnpm run test:coverage",
    "deploy": "bash scripts/deploy.sh",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "allure-vitest": "^3.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^3.2.4"
  }
}

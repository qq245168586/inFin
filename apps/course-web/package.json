{
  "name": "@infini/course-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "bash scripts/deploy.sh",

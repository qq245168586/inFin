INFINI_ENV=local
HOST=0.0.0.0
PORT=3100
INFINI_DATA_ROOT=./storage

# Local MQTT broker. Run EMQX or Mosquitto on the same computer.
MQTT_URL=tcp://127.0.0.1:1883
MQTT_WSS_URL=tcp://127.0.0.1:1883
MQTT_USERNAME=tv1
MQTT_PASSWORD=REDACTED_CONFIGURE_LOCALLY
MQTT_AUTH_PASSWORD=REDACTED_CONFIGURE_LOCALLY
MQTT_TOPIC_CONTROL=infini/tv/control
MQTT_TOPIC_SESSION=infini/tv/session

# Optional gateway stays off locally unless explicitly configured.
MQTT_CLIENT_HTTP_URL=
MQTT_CLIENT_FALLBACK_DIRECT=1

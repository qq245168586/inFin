{
  "openapi": "3.0.3",
  "info": {
    "title": "Infini Platform Server API",
    "version": "1.0.0",
    "description": "Infini 课程编辑端、Coach Web、TV App、场馆管理和 MQTT 调试共用的 Server API。本文档按当前 server.js 实际路由整理。"
  },
  "servers": [
    {
      "url": "https://api.infintraining.work",
      "description": "Production API domain"
    },
    {
      "url": "http://8.130.65.113",
      "description": "Production IP / TV HTTP compatibility"
    },
    {
      "url": "http://127.0.0.1:3100",
      "description": "Local development"
    }
  ],
  "tags": [
    { "name": "Health", "description": "服务健康检查" },
    { "name": "Auth", "description": "登录、刷新 token、用户信息" },
    { "name": "Meta", "description": "编辑端启动基础数据" },
    { "name": "Admin Venues", "description": "场馆、场馆账号、场馆屏幕管理" },
    { "name": "Ops MQTT", "description": "MQTT 调试日志和实时流" },
    { "name": "TV Resources", "description": "TV 拉课表、课程资源和 checksum" },
    { "name": "Playback Sessions", "description": "课程预览、开始、暂停、恢复、终止的统一播放会话" },
    { "name": "TV Screens", "description": "TV 绑定、心跳、解绑、清缓存、安装包下发和控制指令" },
    { "name": "App Packages", "description": "TV APK 等应用安装包管理" },
    { "name": "Uploads", "description": "视频、图片和媒体文件" },
    { "name": "Actions", "description": "动作库和动作分类" },
    { "name": "Courses", "description": "课程、课程分类、课程模板" },
    { "name": "Schedules", "description": "排课" },
    { "name": "Legacy Users", "description": "兼容旧版用户接口" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "access_token"
      },
      "LegacyBasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "固定客户端凭证：REDACTED_CONFIGURE_LOCALLY / REDACTED_CONFIGURE_LOCALLY"
      }
    },
    "parameters": {
      "VenueId": {
        "name": "venueId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "场馆 ID"
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "账号 ID"
      },
      "ActionId": {
        "name": "actionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "动作 ID"
      },
      "CourseId": {
        "name": "courseId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "课程 ID"
      },
      "TemplateId": {
        "name": "templateId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "模板 ID"
      },
      "ScheduleId": {
        "name": "scheduleId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "排课 ID"
      },
      "SessionId": {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Playback Session ID"
      },
      "Filename": {
        "name": "filename",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "文件名"
      }
    },
    "schemas": {
      "AnyObject": {
        "type": "object",
        "additionalProperties": true
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "msg": { "type": "string" },
          "code": { "type": "integer" },
          "error": { "type": "string" }
        }
      },
      "DataEnvelope": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/AnyObject" }
        },
        "additionalProperties": true
      },
      "LegacyEnvelope": {
        "type": "object",
        "properties": {
          "code": { "type": "integer", "example": 200 },
          "message": { "type": "string", "example": "success" },
          "msg": { "type": "string", "example": "success" },
          "data": {}
        },
        "additionalProperties": true
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "13689547720" },
          "password": { "type": "string", "example": "REDACTED_CONFIGURE_LOCALLY" },
          "client": { "type": "string", "example": "editor-web" },
          "clientType": { "type": "string", "example": "coach-web" }
        },
        "additionalProperties": true
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refresh_token": { "type": "string" },
          "refreshToken": { "type": "string" },
          "client": { "type": "string", "example": "editor-web" }
        },
        "additionalProperties": true
      },
      "VenueRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "example": "场馆 A" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      },
      "VenueUserRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "venue_account" },
          "password": { "type": "string", "example": "password" },
          "nickname": { "type": "string", "example": "场馆账号" }
        },
        "additionalProperties": true
      },
      "BindUserRequest": {
        "type": "object",
        "required": ["userId"],
        "properties": {
          "userId": { "type": "integer", "example": 12 }
        }
      },
      "TvScreenRequest": {
        "type": "object",
        "required": ["deviceId", "screenNumber"],
        "properties": {
          "deviceId": { "type": "string", "example": "TV-EE6C8126" },
          "screenNumber": { "type": "integer", "minimum": 1, "maximum": 5, "example": 1 },
          "accountNamespace": { "type": "string", "example": "13689547720" },
          "pairToken": { "type": "string", "example": "B69FAAE7" }
        },
        "additionalProperties": true
      },
      "TvHeartbeatRequest": {
        "type": "object",
        "required": ["deviceId"],
        "properties": {
          "deviceId": { "type": "string", "example": "TV-EE6C8126" },
          "screenNumber": { "type": "integer", "example": 1 },
          "accountNamespace": { "type": "string", "example": "13689547720" },
          "appVersion": { "type": "string", "example": "1.0.0-debug" },
          "playbackState": { "type": "string", "example": "IDLE" },
          "cacheBytes": { "type": "integer", "example": 12345678 }
        },
        "additionalProperties": true
      },
      "TvControlRequest": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["refresh_checksum", "preview_course", "start_course", "pause_course", "resume_course", "terminate_course"]
          },
          "scheduleId": { "type": "string" },
          "playbackSessionId": { "type": "string" },
          "commandId": { "type": "string" },
          "requestedAt": { "type": "integer", "format": "int64" }
        },
        "additionalProperties": true
      },
      "PlaybackPreviewRequest": {
        "type": "object",
        "required": ["commandId", "scheduleId"],
        "properties": {
          "commandId": { "type": "string", "example": "cmd_123" },
          "scheduleId": { "type": "string" },
          "startDelayMs": { "type": "integer", "example": 1500 }
        },
        "additionalProperties": true
      },
      "PlaybackActionRequest": {
        "type": "object",
        "required": ["commandId"],
        "properties": {
          "commandId": { "type": "string", "example": "cmd_123" },
          "startDelayMs": { "type": "integer", "example": 1500 },
          "reason": { "type": "string" }
        },
        "additionalProperties": true
      },
      "NameRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" }
        }
      },
      "ScheduleRequest": {
        "type": "object",
        "required": ["courseId", "beginTime", "duration"],
        "properties": {
          "courseId": { "type": "string" },
          "venueId": { "type": "string" },
          "beginTime": { "type": "string", "example": "2026-05-03T10:00:00+08:00" },
          "duration": { "type": "integer", "example": 45 }
        },
        "additionalProperties": true
      },
      "CopyWeekSchedulesRequest": {
        "type": "object",
        "required": ["coursePackageId", "sourceWeekStart", "targetWeekStart", "replaceExisting"],
        "properties": {
          "coursePackageId": { "type": "string", "example": "1" },
          "sourceWeekStart": { "type": "string", "example": "2026-06-08", "description": "来源周周一，必须是过去周。" },
          "targetWeekStart": { "type": "string", "example": "2026-06-22", "description": "目标周周一，必须是未来周。" },
          "replaceExisting": { "type": "boolean", "example": false }
        },
        "additionalProperties": false
      },
      "AppPackageUploadQuery": {
        "type": "object",
        "properties": {
          "platform": { "type": "string", "example": "tv" },
          "version": { "type": "string", "example": "1.0.1" },
          "label": { "type": "string", "example": "TV 1.0.1" },
          "filename": { "type": "string", "example": "app-debug.apk" },
          "notes": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "登录失效或没有权限",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "当前状态冲突",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "服务健康检查",
        "description": "返回 DB 安全状态、媒体存储模式、TV 控制配置和服务器当前时间。",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/meta": {
      "get": {
        "tags": ["Meta"],
        "summary": "获取编辑端基础元数据",
        "parameters": [{ "name": "venueId", "in": "query", "schema": { "type": "string" }, "description": "可选场馆 ID" }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/editor/bootstrap": {
      "get": {
        "tags": ["Meta"],
        "summary": "编辑端启动数据",
        "description": "编辑端初始化时获取动作类型、课程类型等基础数据。",
        "parameters": [{ "name": "venueId", "in": "query", "schema": { "type": "string" }, "description": "可选场馆 ID" }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/app/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "旧版登录入口",
        "security": [{ "LegacyBasicAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "登录成功" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/app/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "新版登录入口",
        "security": [{ "LegacyBasicAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "description": "登录成功" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/app/refresh": {
      "get": {
        "tags": ["Auth"],
        "summary": "旧版刷新 token",
        "security": [{ "LegacyBasicAuth": [] }],
        "parameters": [{ "name": "refresh_token", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "刷新成功" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "tags": ["Auth"],
        "summary": "旧版刷新 token",
        "security": [{ "LegacyBasicAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } } } },
        "responses": { "200": { "description": "刷新成功" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/app/refresh": {
      "get": {
        "tags": ["Auth"],
        "summary": "新版刷新 token",
        "security": [{ "LegacyBasicAuth": [] }],
        "parameters": [{ "name": "refresh_token", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "刷新成功" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "tags": ["Auth"],
        "summary": "新版刷新 token",
        "security": [{ "LegacyBasicAuth": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } } } },
        "responses": { "200": { "description": "刷新成功" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/user/info": {
      "get": {
        "tags": ["Auth"],
        "summary": "旧版获取当前用户信息",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/user/info": {
      "get": {
        "tags": ["Auth"],
        "summary": "新版获取当前用户信息",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/user/list": {
      "get": {
        "tags": ["Legacy Users"],
        "summary": "旧版用户列表",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/user/list": {
      "get": {
        "tags": ["Legacy Users"],
        "summary": "新版用户列表",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/user/insert": {
      "post": {
        "tags": ["Legacy Users"],
        "summary": "旧版创建用户",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnyObject" } } } },
        "responses": { "200": { "description": "OK" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/user/insert": {
      "post": {
        "tags": ["Legacy Users"],
        "summary": "新版创建用户",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnyObject" } } } },
        "responses": { "200": { "description": "OK" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/admin/venues": {
      "get": {
        "tags": ["Admin Venues"],
        "summary": "获取全部场馆",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "OK" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      },
      "post": {
        "tags": ["Admin Venues"],
        "summary": "新建场馆",
        "description": "命名空间由服务端根据场馆名称生成，操作者不需要手动填写。",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenueRequest" } } } },
        "responses": { "201": { "description": "创建成功" }, "400": { "$ref": "#/components/responses/BadRequest" }, "403": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/api/admin/venues/{venueId}": {
      "patch": {
        "tags": ["Admin Venues"],
        "summary": "更新场馆",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VenueId" }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnyObject" } } } },
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/NotFound" } }
      },
      "delete": {
        "tags": ["Admin Venues"],
        "summary": "删除场馆",
        "description": "删除场馆后会尝试通过 MQTT 通知该场馆 TV 回到二维码页。",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VenueId" }],
        "responses": { "204": { "description": "删除成功" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/admin/venues/{venueId}/users": {
      "get": {
        "tags": ["Admin Venues"],
        "summary": "获取场馆账号",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VenueId" }],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Admin Venues"],
        "summary": "在场馆下创建账号",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VenueId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenueUserRequest" } } } },
        "responses": { "201": { "description": "创建成功" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/admin/venues/{venueId}/screens": {
      "get": {
        "tags": ["Admin Venues"],
        "summary": "获取场馆 TV 屏幕状态",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VenueId" }],
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": ["Admin Venues"],
        "summary": "管理端账号列表",
        "description": "支持搜索、只看未绑定账号、按角色筛选，用于场馆绑定账号。",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "搜索关键词" },
          { "name": "query", "in": "query", "schema": { "type": "string" }, "description": "搜索关键词，兼容 q" },
          { "name": "unbound", "in": "query", "schema": { "type": "string", "enum": ["0", "1"] }, "description": "1 表示只返回未绑定场馆的账号" },
          { "name": "role", "in": "query", "schema": { "type": "string", "example": "venue" }, "description": "角色筛选" }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Admin Venues"],
        "summary": "创建场馆账号",
        "description": "创建后暂不绑定场馆，需要调用 bind-user。",
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VenueUserRequest" } } } },
        "responses": { "201": { "description": "创建成功" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/admin/venues/{venueId}/bind-user": {
      "post": {
        "tags": ["Admin Venues"],
        "summary": "绑定账号到场馆",
        "description": "当前一个账号只能绑定一个场馆。",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VenueId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindUserRequest" } } } },
        "responses": { "200": { "description": "OK" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/admin/users/{userId}/unbind": {
      "post": {
        "tags": ["Admin Venues"],
        "summary": "账号解绑场馆",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "responses": { "200": { "description": "OK" }, "400": { "$ref": "#/components/responses/BadRequest" } }
      }
    },
    "/api/admin/users/{userId}": {
      "patch": {
        "tags": ["Admin Venues"],
        "summary": "修改账号",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnyObject" } } } },
        "responses": { "200": { "description": "OK" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/ops/mqtt/events": {
      "get": {
        "tags": ["Ops MQTT"],
        "summary": "查询 MQTT 历史日志",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "namespace", "in": "query", "schema": { "type": "string" } },
          { "name": "deviceId", "in": "query", "schema": { "type": "string" } },
          { "name": "topic", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string" } },
          { "name": "date", "in": "query", "schema": { "type": "string", "example": "2026-05-03" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 200 } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/ops/mqtt/stream": {
      "get": {
        "tags": ["Ops MQTT"],
        "summary": "订阅 MQTT 实时日志 SSE",
        "description": "EventSource 无法设置 Authorization Header 时，可用 accessToken 和 tokenType=Bearer 查询参数。",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "namespace", "in": "query", "schema": { "type": "string" } },

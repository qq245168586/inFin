{
  "name": "@infini/server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:allure": "INFINI_ALLURE=1 vitest run --coverage",
    "coverage": "pnpm run test:coverage",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "deploy:remote": "bash scripts/deploy-remote.sh",
    "monitor": "bash scripts/monitor-server.sh",
    "install:monitor": "bash scripts/install-monitor-cron.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@types/node": "^25.7.0",
    "mqtt": "^5.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "allure-vitest": "^3.10.0",
    "vitest": "^3.2.4"
  }
}

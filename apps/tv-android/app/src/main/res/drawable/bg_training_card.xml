<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <gradient
        android:angle="135"
        android:startColor="#231237"
        android:endColor="#0F0A17" />
      <stroke android:width="3dp" android:color="@color/tv_accent_gold" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/tv_playback_surface" />
      <stroke android:width="2dp" android:color="@color/tv_playback_border" />
      <corners android:radius="18dp" />
    </shape>
  </item>
</selector>

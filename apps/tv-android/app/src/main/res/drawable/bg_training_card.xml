<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_selected="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/tv_playback_surface" />
      <stroke android:width="3dp" android:color="@color/tv_playback_blue" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/tv_playback_surface" />
      <stroke android:width="2dp" android:color="@color/tv_playback_border" />
    </shape>
  </item>
</selector>

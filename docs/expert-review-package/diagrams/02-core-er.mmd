  USER {
    string id
    string account
    string role
    string venueId
    boolean enabled
  }

  VENUE {
    string id
    string name
    string accountNamespace
    number activeCoursePackageId
  }

  COURSE_PACKAGE {
    number id
    string name
    string description
    boolean isDefault
  }

  COURSE {
    number id
    string name
    string version
    string creator
  }

  SCHEDULE {
    number id
    number courseId
    number coursePackageId
    string beginTime
    number duration
  }

  TV_SCREEN {
    string deviceId
    number screenNumber
    string accountNamespace
    string appVersion
    string playbackState
    string lastSeenAt
  }

  PLAYBACK_SESSION {
    string id
    string accountNamespace
    number scheduleId
    number courseId
    string state
    number serverStartAtMs
    number playbackStartAtMs
  }

  ACTION {
    number id
    string name
    number actionTypeId
    string mediaId
  }

  MEDIA {
    string id
    string filename
    string checksum
    number size
  }


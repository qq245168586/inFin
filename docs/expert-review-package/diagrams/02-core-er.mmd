  COURSE_PACKAGE ||--o{ SCHEDULE : contains
  COURSE_PACKAGE }o--o{ COURSE : includes
  COURSE ||--o{ SCHEDULE : scheduled_as
  COURSE ||--o{ COURSE_SCRIPT : has
  COURSE_SCRIPT ||--o{ VIDEO_GROUP : uses
  COURSE_SCRIPT ||--o{ POD : contains
  VIDEO_GROUP ||--o{ VIDEO_GROUP_SCREEN : contains
  VIDEO_GROUP_SCREEN ||--o{ VIDEO_CARD : contains
  ACTION ||--o{ VIDEO_CARD : referenced_by

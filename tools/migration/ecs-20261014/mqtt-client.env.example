# Install as /etc/infini/mqtt-client.env with mode 0640 and owner root:infini.
# EMQX accepts only local WebSocket connections; public clients use
# wss://114.215.185.184/infini/mqtt through Nginx.
MQTT_URL=ws://127.0.0.1:8083/mqtt
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_HTTP_TOKEN=
MQTT_LOG_RETENTION_DAYS=30

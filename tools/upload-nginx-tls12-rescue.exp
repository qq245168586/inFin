set timeout 60
set host "REDACTED_CONFIGURE_LOCALLY@8.130.65.113"
set password "REDACTED_CONFIGURE_LOCALLY"
spawn scp -o StrictHostKeyChecking=no tools/nginx-tls12-rescue.sh $host:/home/REDACTED_CONFIGURE_LOCALLY/nginx-tls12-rescue.sh
expect {
  -re "(?i)password:" {
    send "$password\r"
    exp_continue
  }
  eof
}
catch wait result
exit [lindex $result 3]
